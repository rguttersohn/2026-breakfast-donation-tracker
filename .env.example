# Private (server-only) – S3 credentials
NUXT_S3_BUCKET=
NUXT_S3_KEY=
NUXT_S3_SECRET_KEY=

# Public – exposed to the client
# How often (ms) the sheet is re-fetched; defaults to 60000 if unset (app/app.vue)
NUXT_FETCH_INTERVAL=60000
# Google Sheet ID (from docs.google.com/spreadsheets/d/<SHEET_ID>/...)
NUXT_SHEET_ID=
# Tab gid (from the sheet URL ...#gid=<GID>)
NUXT_GID=

CLOUDFRONT_DISTRIBUTION_ID=
#cdn id for the app